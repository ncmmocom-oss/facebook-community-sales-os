{
  "manifest_version": 3,
  "name": "Social AIO Worker Keeper",
  "short_name": "AIO Keeper",
  "version": "1.2.0",
  "description": "Production-hardened W1 keeper: sticky tab binding, auto restore/reconnect, error watch, health logs and Client ID guard.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://fbaio.org/*",
    "https://www.fbaio.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Social AIO Worker Keeper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fbaio.org/*",
        "https://www.fbaio.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
