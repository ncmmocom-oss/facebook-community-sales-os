{
  "manifest_version": 3,
  "name": "Social AIO Worker Keeper",
  "version": "1.1.0",
  "description": "Keeps one Social AIO /apis worker tab healthy, binds a chosen Worker URL, and reconnects safely after reload or transient WebSocket drops.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://fbaio.org/*",
    "https://www.fbaio.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Social AIO Worker Keeper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fbaio.org/*",
        "https://www.fbaio.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
